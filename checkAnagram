// Online C++ compiler to run C++ program online
#include <iostream>

using namespace std;

bool checkAnagram(string s , string t){
    
    if(s.length()!=t.length()){
        return false;
    }
    
    int count[26] = {0};
    
    
    for(int i=0;i<s.length();i++){
        
        count[s[i] - 'a']++;
    }
    
     for(int i=0;i<t.length();i++){
        
        count[t[i] - 'a']--;
    }
    
    for(int i=0;i<26;i++){
        
        if(count[i]!=0){
            return false;
        }
    }
    
    return true;
    
};

int main(){
    
    string s = "silent";
    string t = "listen";
    
    bool checkAna = checkAnagram(s,t);
    
    if(checkAna){
        
        cout<<"true";
    }else{
        
        cout<<"false";
    }
    
    return 0;
}
